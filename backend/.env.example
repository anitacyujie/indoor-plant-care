# Copy this file to .env (git-ignored) and fill in real values.
# Real environment variables take precedence over .env.

# Read by the Anthropic SDK itself; the app code never handles the key.
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Model that reads fertilizer label photos. The eval compares models, so it is configurable.
LABEL_MODEL=claude-opus-5-5
